# Insert these directives in the operator's nginx http {} context.
# Replace scanner.example.invalid and certificate paths before enabling.
limit_req_zone $server_name zone=scanner_rate:1m rate=2r/s;
limit_conn_zone $server_name zone=scanner_connections:1m;
server {
    listen 443 ssl;
    server_name scanner.example.invalid;
    ssl_certificate /etc/audit-scanner/tls/fullchain.pem;
    ssl_certificate_key /etc/audit-scanner/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/audit-scanner-error.log crit;
    client_max_body_size 10m;
    client_body_buffer_size 10m;
    client_body_timeout 10s;
    client_header_timeout 5s;
    keepalive_timeout 5s;
    limit_req zone=scanner_rate burst=4 nodelay;
    limit_conn scanner_connections 4;
    limit_req_status 429;
    limit_conn_status 429;
    location = /scan {
        limit_except POST { deny all; }
        proxy_request_buffering on;
        proxy_buffering on;
        proxy_connect_timeout 2s;
        proxy_send_timeout 10s;
        proxy_read_timeout 43s;
        proxy_next_upstream off;
        proxy_pass http://127.0.0.1:8080;
    }
    location / { return 404; }
}
